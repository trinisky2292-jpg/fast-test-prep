  "1-7": {
    "title": "Solve problems with rational numbers",
    "standard": "MA.6.NSO.2.3",
    "learn": "HOW TO SOLVE WORD PROBLEMS WITH RATIONAL NUMBERS\n\nRead carefully, decide which operation the problem needs, then compute with your decimals or fractions. Clue words help: 'total/in all' = add; 'how much more/left' = subtract; 'each/per group' or 'of' = multiply or divide.\n\nExample 1 — A ribbon is 3/4 meter long. You cut it into pieces that are each 1/8 meter. How many pieces?\nStep 1: 'How many pieces fit' means divide: 3/4 / 1/8.\nStep 2: Keep-Change-Flip: 3/4 x 8/1 = 24/4 = 6.\nAnswer: 6 pieces\n\nExample 2 — Apples cost $1.25 each. How much do 4 apples cost?\nStep 1: 'Each' repeated means multiply: 1.25 x 4.\nStep 2: 125 x 4 = 500, with 2 decimal places: 5.00.\nAnswer: $5.00\n\nExample 3 — You have $20.00 and spend $7.45. How much is left?\nStep 1: 'How much left' means subtract: 20.00 - 7.45.\nStep 2: Line up the decimals and subtract: 20.00 - 7.45 = 12.55.\nAnswer: $12.55",
    "questions": [
      { "id": "1-7-q1", "section": "math", "question": "A ribbon 3/4 meter long is cut into 1/8 meter pieces. How many pieces?", "choices": { "A": "3", "B": "6", "C": "8", "D": "4" }, "correctAnswer": "B", "explanation": "Divide: 3/4 / 1/8 = 3/4 x 8/1 = 24/4 = 6 pieces.", "standard": "MA.6.NSO.2.3", "difficulty": "medium" },
      { "id": "1-7-q2", "section": "math", "question": "Apples cost $1.25 each. How much do 4 apples cost?", "choices": { "A": "$5.00", "B": "$4.25", "C": "$5.25", "D": "$4.00" }, "correctAnswer": "A", "explanation": "Multiply: 1.25 x 4 = 5.00.", "standard": "MA.6.NSO.2.3", "difficulty": "easy" },
      { "id": "1-7-q3", "section": "math", "question": "You have $20.00 and spend $7.45. How much money is left?", "choices": { "A": "$13.55", "B": "$12.55", "C": "$12.45", "D": "$13.45" }, "correctAnswer": "B", "explanation": "Subtract: 20.00 - 7.45 = 12.55.", "standard": "MA.6.NSO.2.3", "difficulty": "medium" },
      { "id": "1-7-q4", "section": "math", "question": "A recipe needs 2/3 cup of sugar. You make half the recipe. How much sugar?", "choices": { "A": "1/3 cup", "B": "1 1/3 cups", "C": "2/6 cup, which is more than 1/2", "D": "4/3 cup" }, "correctAnswer": "A", "explanation": "Half of 2/3: 1/2 x 2/3 = 2/6 = 1/3 cup.", "standard": "MA.6.NSO.2.3", "difficulty": "medium" },
      { "id": "1-7-q5", "section": "math", "question": "A runner goes 2.5 miles each day for 6 days. How far in total?", "choices": { "A": "8.5 miles", "B": "12.5 miles", "C": "15 miles", "D": "15.5 miles" }, "correctAnswer": "C", "explanation": "Multiply: 2.5 x 6 = 15 miles.", "standard": "MA.6.NSO.2.3", "difficulty": "easy" },
      { "id": "1-7-q6", "section": "math", "question": "A 4 1/2 pound bag of rice is split into 3/4 pound servings. How many servings?", "choices": { "A": "5", "B": "6", "C": "4", "D": "7" }, "correctAnswer": "B", "explanation": "Divide: 9/2 / 3/4 = 9/2 x 4/3 = 36/6 = 6 servings.", "standard": "MA.6.NSO.2.3", "difficulty": "hard" },
      { "id": "1-7-q7", "section": "math", "question": "Three friends share $8.40 equally. How much does each get?", "choices": { "A": "$2.80", "B": "$2.40", "C": "$2.20", "D": "$3.80" }, "correctAnswer": "A", "explanation": "Divide: 8.40 / 3 = 2.80.", "standard": "MA.6.NSO.2.3", "difficulty": "medium" },
      { "id": "1-7-q8", "section": "math", "question": "Maria buys 3.5 pounds of grapes at $2.00 per pound. What is the cost?", "choices": { "A": "$5.50", "B": "$6.00", "C": "$7.00", "D": "$5.00" }, "correctAnswer": "C", "explanation": "Multiply: 3.5 x 2.00 = 7.00.", "standard": "MA.6.NSO.2.3", "difficulty": "medium" },
      { "id": "1-7-q9", "section": "math", "question": "A board is 5/6 meter long. You use 1/3 meter. How much is left?", "choices": { "A": "1/2 meter", "B": "4/3 meter", "C": "1/6 meter", "D": "2/3 meter" }, "correctAnswer": "A", "explanation": "Subtract: 5/6 - 1/3 = 5/6 - 2/6 = 3/6 = 1/2 meter.", "standard": "MA.6.NSO.2.3", "difficulty": "hard" },
